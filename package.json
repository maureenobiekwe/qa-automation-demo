{
  "name": "zojatech-qa-demo",
  "private": true,
  "description": "QA automation demo: web (Playwright), API (Playwright + Postman/Newman), mobile (WebdriverIO + Appium), load (k6).",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test tests/web",
